<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#ffffff"
    android:orientation="vertical"
    tools:context=".Pending_user">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbarSize="0dp"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical">
            <!--header-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="15dp"
                android:background="#FFC83F"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/back"
                    android:layout_width="40dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="19dp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginLeft="20dp"
                    android:scaleType="fitCenter"
                    android:layout_marginRight="20dp"
                    android:src="@drawable/baseline_arrow_back_24" />
                <TextView
                    android:id="@+id/add"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="70dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="10dp"
                    android:text="Pending"
                    android:textColor="#023d43"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <!-- Example Order 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="18dp"
                android:background="@drawable/shape"
                android:backgroundTint="#ffffff"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:elevation="14dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tv_order_details_1"
                        android:layout_width="230dp"
                        android:layout_height="wrap_content"
                        android:text="Services: Washing, Ironing"
                        android:textSize="18sp"
                        android:layout_marginTop="4dp"
                        android:textColor="#616161" />

                    <TextView
                        android:id="@+id/tv_order_status_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pending"
                        android:paddingStart="15dp"
                        android:textSize="17sp"
                        android:layout_marginStart="0dp"
                        android:textColor="#FFC107"
                        android:textStyle="italic" />
                </LinearLayout>


                <TextView
                    android:id="@+id/tv_order_date_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date:  18_9_2024"
                    android:textSize="18sp"
                    android:layout_marginTop="4dp"
                    android:textColor="#616161" />
            </LinearLayout>
            <!-- Example Order 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:background="@drawable/shape"
                android:backgroundTint="#ffffff"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:elevation="14dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/order_details_1"
                        android:layout_width="230dp"
                        android:layout_height="wrap_content"
                        android:text="Services: Dry Cleaning"
                        android:textSize="18sp"
                        android:layout_marginTop="4dp"
                        android:textColor="#616161" />
                    <TextView
                        android:id="@+id/order_status_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pending"
                        android:paddingStart="15dp"                        android:textSize="17sp"
                        android:layout_marginStart="0dp"
                        android:textColor="#FFC107"
                        android:textStyle="italic" />
                </LinearLayout>



                <TextView
                    android:id="@+id/order_date_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date:  9_10_2024"
                    android:textSize="18sp"
                    android:layout_marginTop="4dp"
                    android:textColor="#616161" />
            </LinearLayout>
            <!-- Example Order 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:background="@drawable/shape"
                android:backgroundTint="#ffffff"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:elevation="14dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/order_details"
                        android:layout_width="230dp"
                        android:layout_height="wrap_content"
                        android:text="Services: Carpet Wash"
                        android:textSize="18sp"
                        android:layout_marginTop="4dp"
                        android:textColor="#616161" />
                    <TextView
                        android:id="@+id/order_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pending"
                        android:paddingStart="15dp"                        android:textSize="17sp"
                        android:layout_marginStart="0dp"
                        android:textColor="#FFC107"
                        android:textStyle="italic" />
                </LinearLayout>
                <TextView
                    android:id="@+id/order_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date: 18_1_2025"
                    android:textSize="18sp"
                    android:layout_marginTop="4dp"
                    android:textColor="#616161" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>